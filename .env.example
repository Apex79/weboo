# ClothCare — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.

# ----------------------------------------------------------------------
# PORT (local development only)
# The port the standalone server.js listens on.
# On Vercel this is managed automatically — do not set it there.
# ----------------------------------------------------------------------
PORT=3000

# ----------------------------------------------------------------------
# VERCEL (set automatically by Vercel — do not set manually)
# The api/_data.js helper checks for VERCEL=1 to decide whether to
# use /tmp for writes (Vercel) or the local data/ directory (dev).
# ----------------------------------------------------------------------
# VERCEL=1

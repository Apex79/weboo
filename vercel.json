{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/register",
      "destination": "/api/register.js"
    },
    {
      "source": "/api/login",
      "destination": "/api/login.js"
    },
    {
      "source": "/api/donations",
      "destination": "/api/donations.js"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin.js"
    }
  ]
}
